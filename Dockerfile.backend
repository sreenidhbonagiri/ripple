# Ripple API — runtime secrets via environment only (never bake .env into the image).
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend /app/backend
# Benchmark artifact for Tiger evidence panel (saved timings; not re-run at runtime).
COPY artifacts /app/artifacts
# Nominal L-Town model must be present in the build context (gitignored under data/).
COPY data/L-TOWN.inp /app/data/L-TOWN.inp

ENV PYTHONPATH=/app/backend
ENV RIPPLE_INP_PATH=/app/data/L-TOWN.inp
ENV RIPPLE_HOST=0.0.0.0
ENV RIPPLE_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
