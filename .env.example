# Ripple environment placeholders (no credentials)
# Copy to .env and adjust for local development.

# Backend
RIPPLE_INP_PATH=data/L-TOWN.inp
RIPPLE_HOST=127.0.0.1
RIPPLE_PORT=8000

# Frontend (Vite local-dev only). Leave unset / empty for Docker — nginx proxies /api.
# Do not set this when building the frontend image.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Tiger Cloud / TimescaleDB (no credentials in this example)
DATABASE_URL=

# Required for SCADA imports: Tiger Console service storage limit (bytes).
# Free tier confirmed at 750 MiB → 786432000. Working ceiling is 80% of this
# (20% headroom) → 629145600. No default fallback; imports refuse if unset.
RIPPLE_STORAGE_LIMIT_BYTES=786432000

# Optional: comma-separated browser origins allowed by the API (Docker/Vultr).
# Local Docker default is fine for http://127.0.0.1:8080.
# Behind Caddy HTTPS, prefer:
# RIPPLE_CORS_ORIGINS=https://followtheripple.us,https://www.followtheripple.us
# RIPPLE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional override for January raw/CAGG benchmark artifact path.
# RIPPLE_BENCHMARK_ARTIFACT=artifacts/january_raw_cagg_benchmark.json
